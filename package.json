{
	"$schema": "https://www.schemastore.org/package",
	"private": true,
	"type": "module",
	"scripts": {
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"ts:check": "tsc --noEmit",
		"ts:emit": "tsc --build"
	},
	"devDependencies": {
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.17",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": "^22.11 || ^24.11 || ^26.13",
			"onFail": "error"
		}
	}
}
